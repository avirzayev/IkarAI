IKARIAM_USERNAME=you@example.com
IKARIAM_PASSWORD=
IKARIAM_SERVER=s401-en.ikariam.gameforge.com
IKARIAM_CITY_NAME=

NOTION_TOKEN=ntn_your_internal_integration_token
NOTION_ROOT_PAGE_ID=

# IANA timezone name used for log timestamps and the Daily Log's "today"
# date. Defaults to UTC if unset.
TIMEZONE=Asia/Jerusalem

# The following are written automatically by `make bootstrap`
# (scripts/bootstrap_kb.py) — leave blank on first setup.
NOTION_ACTION_CATALOG_DB_ID=
NOTION_DAILY_LOGS_DB_ID=
NOTION_DIPLOMACY_DB_ID=
NOTION_PROFILE_PAGE_ID=
NOTION_STRATEGY_PAGE_ID=
NOTION_WORLD_KNOWLEDGE_PAGE_ID=
NOTION_HUMAN_REQUIRED_DB_ID=
NOTION_STRATEGY_ARCHIVE_PAGE_ID=
NOTION_TOKEN_USAGE_DB_ID=

# Optional run tuning (scripts/run_hourly_cycle.sh). Defaults shown.
# IKARAI_MODEL=claude-sonnet-5
# IKARAI_EFFORT=medium          # low | medium | high
# IKARAI_MAX_BUDGET_USD=        # hard per-cycle spend cap, unset = none
